# Copy to /etc/elysium-lp-report.env and chmod 640.
# Do not commit a filled copy.
# REQUIRED for report.js. Use the public address you want to watch.
# Leave the placeholder here. A filled copy stays out of git.
# An empty value or this placeholder exits with setup instructions and does not send a failure push.

BARK_KEY=YOUR_BARK_DEVICE_KEY
BARK_SERVER=https://api.day.app
DEFAULT_ADDRESS=0xYOUR_WALLET_ADDRESS

# Optional:
# DRY_RUN=1
# ENTRY_CACHE=/path/to/.elysium-lp-entry-cache.json
# CLAIMS_FILE=/path/to/.elysium-lp-claims.json
# ACTIVE_IDS_FILE=/path/to/.elysium-lp-active-ids.json
# REFERENCE_FILE=/path/to/.elysium-lp-reference.json
# ALERTS_FILE=/path/to/.elysium-lp-alerts.json
# APR_ALERT_THRESHOLD=20000
# ALERT_COOLDOWN_MINUTES=30
